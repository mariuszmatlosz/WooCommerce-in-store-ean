{
	"name": "mariuszmatlosz/ean-to-pos",
	"description": "Scan EANs or SKUs to record in-store WooCommerce sales and stock movements.",
	"license": "MIT",
	"type": "wordpress-plugin",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"10up/phpcs-composer": "^3.0",
		"phpunit/phpunit": "^9.6",
		"wp-phpunit/wp-phpunit": "^6.7",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"scripts": {
		"lint": "phpcs --standard=phpcs.xml",
		"lint:fix": "phpcbf --standard=phpcs.xml",
		"test:unit": "phpunit -c phpunit.xml.dist",
		"test:integration": "phpunit -c phpunit.integration.xml.dist",
		"test:install": "bash bin/install-wp-tests.sh wordpress_test root root 127.0.0.1"
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
