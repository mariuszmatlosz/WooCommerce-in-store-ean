<?xml version="1.0"?>
<ruleset name="EAN to PoS">
	<description>10up coding standards for the EAN to PoS plugin.</description>

	<file>.</file>

	<exclude-pattern>node_modules/</exclude-pattern>
	<exclude-pattern>vendor/</exclude-pattern>
	<exclude-pattern>dist/</exclude-pattern>
	<exclude-pattern>build/</exclude-pattern>
	<exclude-pattern>languages/</exclude-pattern>
	<exclude-pattern>tests/wp-tests-config*.php</exclude-pattern>

	<rule ref="10up-Default" />

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_supported_wp_version" value="6.5"/>

	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="edit_shop_orders"/>
				<element value="edit_products"/>
				<element value="edit_product"/>
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ean-to-pos"/>
			</property>
		</properties>
	</rule>

	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="basepath" value="."/>
	<arg name="extensions" value="php"/>
</ruleset>
